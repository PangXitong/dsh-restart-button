{
  "name": "@pangxitong/dsh-restart-button",
  "version": "0.2.0",
  "description": "Power button in the DeepSeek Harness (dsh) Web UI session header: click to expand a Close / Restart pair that shuts down or relaunches the whole DSH process. Self-contained, no external scripts.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "screenshot-1.png",
    "screenshot-2.png",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "close",
    "power-button",
    "web-ui"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PangXitong/dsh-restart-button.git"
  },
  "bugs": {
    "url": "https://github.com/PangXitong/dsh-restart-button/issues"
  },
  "homepage": "https://github.com/PangXitong/dsh-restart-button#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0 || >=5.0.0-rc.1 <6.0.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
